# cp .env.example .env して編集する（.env は git 管理外）

# --- IP（ここだけ環境に合わせて変える） ---
# LiveKit がクライアントに伝える IP。
#   ローカル/LAN で試す: そのマシンの LAN の IP（例: 192.168.1.10）
#   外のネットから使う: 外から見えるグローバル IP（ルーターで UDP 7882 / TCP 7881 を開放）
LIVEKIT_NODE_IP=192.168.1.10
# true にすると起動時に STUN で外の IP を調べる（IP が変わる環境向け。変わったら再起動）
LIVEKIT_USE_EXTERNAL_IP=false
# ブラウザから届く LiveKit のアドレス。空なら ws://<LIVEKIT_NODE_IP>:7880
#   ページが https の場合は wss://livekit.example.com のようにする（Tunnel / リバプロ越し）
LIVEKIT_PUBLIC_URL=

# --- 必須の秘密（16文字以上のランダム値: openssl rand -hex 32） ---
REDIS_PASSWORD=
SESSION_SECRET=
PLUGIN_API_KEY=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# --- 管理者（Super Admin）の UUID（カンマ区切り、ハイフン付き）。空なら管理パネルは誰にも出ない ---
SUPER_ADMIN_UUIDS=

# --- 任意 ---
# Redis を LAN の Paper に公開するなら LAN の IP に（既定は同じマシンのみ）。パスワード必須
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379
MSAL_BIND_IP=0.0.0.0
MSAL_PORT=8010
LIVEKIT_PORT=7880
# リバースプロキシ（Cloudflare Tunnel など）の段数。直接アクセスなら 0
TRUST_PROXY=1
# msal-node のイメージ。既定は GHCR の latest。固定したいなら ghcr.io/swmr71/msal-node:sha-xxxxxxx
MSAL_IMAGE=ghcr.io/swmr71/msal-node:latest
# ソースからビルドするとき（docker-compose.build.yml）だけ使う: ffmpeg を入れるか
INSTALL_FFMPEG=1
