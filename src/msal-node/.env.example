PORT=8010

# --- 必須（16文字以上のランダム値。例: openssl rand -hex 32） ---
SESSION_SECRET=
# プラグイン -> バックエンド API の共有シークレット（plugins/MSALPlugin/config.yml の backend.api-key と同じ値）
PLUGIN_API_KEY=

REDIS_URL=redis://:PASSWORD@HOST:6379/0

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://livekit.example.com
# msal-node が音源を publish するときに繋ぐ LiveKit のアドレス（内部アドレスがあれば。空なら LIVEKIT_WS_URL）
LIVEKIT_INTERNAL_URL=

# --- 管理者（Super Admin / Sawamura） ---
# 管理パネルを使えるユーザーの UUID（カンマ区切り）。ハイフン付き
SUPER_ADMIN_UUIDS=
# 放送の最大継続時間（秒）。stop し忘れの防止
BROADCAST_MAX_SECONDS=300
# 放送中、他の音声が残る割合（%）の初期値。管理パネルで 0〜100 に変更可能
DEFAULT_DUCK_PERCENT=30

# --- 音源 API（動画の音など） ---
# URL 方式で使う ffmpeg（push 方式だけなら不要）
FFMPEG_PATH=ffmpeg
# 同時に作れる音源の数 / push が途切れてから自動撤去するまでの秒数
AUDIO_MAX_SOURCES=8
AUDIO_IDLE_TIMEOUT_SEC=30

# --- 任意 ---
# Cloudflare Tunnel など、リバースプロキシの段数
TRUST_PROXY=1
SESSION_MAX_AGE_HOURS=12
# ログインコード（ワンタイム）の有効期限（秒）
LOGIN_TOKEN_TTL_SEC=300
# ログイン失敗の上限回数 / 集計ウィンドウ（秒）
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SEC=300
DB_PATH=./db.sqlite3
# 別オリジンから使う場合のみ（カンマ区切り）。空 = 同一オリジンのみ
ALLOWED_ORIGINS=
